<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E2E2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectar a"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/seletorAlvo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#00BB59"
            android:contentDescription="Escolher simulador ou inversor" />

        <TextView
            android:id="@+id/statusConexao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Aguardando conexão"
            android:textColor="#BDBDBD"
            android:textSize="12sp" />

        <Button
            android:id="@+id/botaoAtualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ATUALIZAR LEITURA" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#080B09"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="-----"
                    android:textColor="#00FF70"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISPLAY DO INVERSOR"
                    android:textColor="#00BB59"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Potenciômetro (0–255)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/valorPotenciometroLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O valor aparece no visor"
            android:textColor="#BDBDBD" />

        <com.google.android.material.slider.Slider
            android:id="@+id/frequenccySlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="120"
            android:valueFrom="0"
            android:valueTo="255"
            app:haloColor="#40009846"
            app:labelBehavior="gone"
            app:thumbColor="#FFFFFF"
            app:thumbRadius="10dp"
            app:trackColorActive="#009846"
            app:trackColorInactive="#555555"
            app:trackHeight="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button4"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:backgroundTint="#009846"
                android:text="RUN"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button3"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="#E50019"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="PRG / ESC"
                android:textSize="11sp" />
            <Button
                android:id="@+id/buttonUp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="▲" />
            <Button
                android:id="@+id/button8"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="DATA / ENT"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button6"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="QUICK / JOG"
                android:textSize="10sp" />
            <Button
                android:id="@+id/buttonDown"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="▼" />
            <Button
                android:id="@+id/button9"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="SHIFT"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1E1E21"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <View android:id="@+id/ledHz" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/led_off" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hz" android:textColor="#FFFFFF" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <View android:id="@+id/ledA" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/led_off" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A" android:textColor="#FFFFFF" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <View android:id="@+id/ledV" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/led_off" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V" android:textColor="#FFFFFF" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <View android:id="@+id/ledRun" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/led_off" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RUN" android:textColor="#FFFFFF" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <View android:id="@+id/ledLocal" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/led_off" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L/R" android:textColor="#FFFFFF" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <View android:id="@+id/ledFwd" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/led_off" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="F/R" android:textColor="#FFFFFF" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <View android:id="@+id/ledTune" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/led_off" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T/TC" android:textColor="#FFFFFF" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1E1E21"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ENTRADAS DIGITAIS (4 bits)" android:textColor="#FFFFFF" android:textStyle="bold" />
                <CheckBox android:id="@+id/entradaDigital0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entrada digital 0" android:textColor="#FFFFFF" />
                <CheckBox android:id="@+id/entradaDigital1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entrada digital 1" android:textColor="#FFFFFF" />
                <CheckBox android:id="@+id/entradaDigital2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entrada digital 2" android:textColor="#FFFFFF" />
                <CheckBox android:id="@+id/entradaDigital3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Entrada digital 3" android:textColor="#FFFFFF" />

                <TextView android:id="@+id/valorEntradaAnalogica" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Entrada analógica: 0" android:textColor="#FFFFFF" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderEntradaAnalogica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="255"
                    app:labelBehavior="gone" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="SAÍDAS (somente leitura)" android:textColor="#FFFFFF" android:textStyle="bold" />
                <TextView android:id="@+id/saidaDigitalTitulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saída digital:" android:textColor="#BDBDBD" />
                <TextView android:id="@+id/valorSaidaDigital" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#00FF70" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saída analógica:" android:textColor="#BDBDBD" />
                <TextView android:id="@+id/valorSaidaAnalogica" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#00FF70" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
